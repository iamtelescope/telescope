{
  "slug": "python-runtime",
  "name": "Python Runtime Metrics",
  "description": "CPU utilization, memory usage, GC collections, and thread count for Python applications with the OTel Runtime Metrics instrumentation",
  "tags": [
    "OTel",
    "Metrics",
    "Runtime"
  ],
  "roles": {
    "metrics": {
      "label": "Metrics",
      "signal": "metrics"
    }
  },
  "dashboard": {
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "query": "",
    "refresh": "off",
    "variables": [
      {
        "name": "service",
        "label": "Service",
        "type": "values",
        "source": "{{metrics}}",
        "column": "{{metrics.service}}",
        "multi": true
      }
    ],
    "sections": [],
    "tiles": [
      {
        "id": "b028c5",
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4,
        "title": "Memory RSS",
        "chart": {
          "source": "{{metrics}}",
          "display": "number",
          "series": [
            {
              "agg": "metric",
              "metric": {
                "name": "process.memory.usage",
                "type": "sum",
                "agg": "avg"
              }
            }
          ],
          "query": "{{metrics.service}} = $service",
          "group_by": "",
          "granularity": "auto",
          "limit": 10,
          "number_format": {
            "unit": "bytes",
            "decimals": 1
          }
        }
      },
      {
        "id": "c847ba",
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4,
        "title": "CPU Utilization",
        "chart": {
          "source": "{{metrics}}",
          "display": "number",
          "series": [
            {
              "agg": "metric",
              "metric": {
                "name": "process.cpu.utilization",
                "type": "gauge",
                "agg": "avg"
              },
              "alias": "v",
              "hidden": true
            },
            {
              "agg": "formula",
              "formula": "v * 100",
              "alias": "value"
            }
          ],
          "query": "{{metrics.service}} = $service",
          "group_by": "",
          "granularity": "auto",
          "limit": 10,
          "number_format": {
            "unit": "percent",
            "decimals": 1
          }
        }
      },
      {
        "id": "c02ef1",
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4,
        "title": "GC Collections",
        "chart": {
          "source": "{{metrics}}",
          "display": "number",
          "series": [
            {
              "agg": "metric",
              "metric": {
                "name": "cpython.gc.collections",
                "type": "sum",
                "agg": "increase"
              }
            }
          ],
          "query": "{{metrics.service}} = $service",
          "group_by": "",
          "granularity": "auto",
          "limit": 10,
          "number_format": {
            "unit": "number",
            "decimals": 0
          }
        }
      },
      {
        "id": "f0634b",
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4,
        "title": "GC Leaks",
        "chart": {
          "source": "{{metrics}}",
          "display": "number",
          "series": [
            {
              "agg": "metric",
              "metric": {
                "name": "cpython.gc.uncollectable_objects",
                "type": "sum",
                "agg": "increase"
              }
            }
          ],
          "query": "{{metrics.service}} = $service",
          "group_by": "",
          "granularity": "auto",
          "limit": 10,
          "number_format": {
            "unit": "number",
            "decimals": 0
          }
        }
      },
      {
        "id": "9adc01",
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7,
        "title": "Memory Usage",
        "chart": {
          "source": "{{metrics}}",
          "display": "line",
          "series": [
            {
              "agg": "metric",
              "metric": {
                "name": "process.memory.usage",
                "type": "sum",
                "agg": "avg"
              }
            }
          ],
          "query": "{{metrics.service}} = $service",
          "group_by": "",
          "granularity": "auto",
          "limit": 10,
          "number_format": {
            "unit": "bytes",
            "decimals": 1
          }
        }
      },
      {
        "id": "3a5843",
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7,
        "title": "CPU Utilization",
        "chart": {
          "source": "{{metrics}}",
          "display": "line",
          "series": [
            {
              "agg": "metric",
              "metric": {
                "name": "process.cpu.utilization",
                "type": "gauge",
                "agg": "avg"
              },
              "alias": "v",
              "hidden": true
            },
            {
              "agg": "formula",
              "formula": "v * 100",
              "alias": "value"
            }
          ],
          "query": "{{metrics.service}} = $service",
          "group_by": "",
          "granularity": "auto",
          "limit": 10,
          "number_format": {
            "unit": "percent",
            "decimals": 1
          }
        }
      },
      {
        "id": "be51d5",
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7,
        "title": "GC Collections (rate)",
        "chart": {
          "source": "{{metrics}}",
          "display": "line",
          "series": [
            {
              "agg": "metric",
              "metric": {
                "name": "cpython.gc.collections",
                "type": "sum",
                "agg": "increase"
              },
              "alias": "gc_count"
            }
          ],
          "query": "{{metrics.service}} = $service",
          "group_by": "",
          "granularity": "auto",
          "limit": 10
        }
      },
      {
        "id": "421240",
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7,
        "title": "Collected vs Uncollectable Objects",
        "chart": {
          "source": "{{metrics}}",
          "display": "line",
          "series": [
            {
              "agg": "metric",
              "metric": {
                "name": "cpython.gc.collected_objects",
                "type": "sum",
                "agg": "increase"
              },
              "alias": "collected"
            },
            {
              "agg": "metric",
              "metric": {
                "name": "cpython.gc.uncollectable_objects",
                "type": "sum",
                "agg": "increase"
              },
              "alias": "leaks (uncollectable)"
            }
          ],
          "query": "{{metrics.service}} = $service",
          "group_by": "",
          "granularity": "auto",
          "limit": 10
        }
      },
      {
        "id": "50a6fb",
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 7,
        "title": "CPU Seconds Used",
        "chart": {
          "source": "{{metrics}}",
          "display": "line",
          "series": [
            {
              "agg": "metric",
              "metric": {
                "name": "process.cpu.time",
                "type": "sum",
                "agg": "rate"
              }
            }
          ],
          "query": "{{metrics.service}} = $service",
          "group_by": "",
          "granularity": "auto",
          "limit": 10
        }
      },
      {
        "id": "d72a48",
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 7,
        "title": "Threads & Context Switches",
        "chart": {
          "source": "{{metrics}}",
          "display": "line",
          "series": [
            {
              "agg": "metric",
              "metric": {
                "name": "process.thread.count",
                "type": "gauge",
                "agg": "avg"
              },
              "alias": "threads"
            },
            {
              "agg": "metric",
              "metric": {
                "name": "process.context_switches",
                "type": "sum",
                "agg": "increase"
              },
              "alias": "ctx switches"
            }
          ],
          "query": "{{metrics.service}} = $service",
          "group_by": "",
          "granularity": "auto",
          "limit": 10
        }
      }
    ]
  }
}
